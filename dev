#!/usr/bin/env bash
#
# Single entry point for the development stack.
#
#   ./dev              Build and start everything, then open one log window per service
#   ./dev down         Stop the stack and remove orphans
#   ./dev rebuild      Force a no-cache image rebuild, then start
#   ./dev windows      Re-open the four per-service log windows
#   ./dev logs [svc]   Follow logs inline in this terminal
#   ./dev shell [svc]  Interactive shell in a container
#   ./dev console      Rails console
#   ./dev dbconsole    psql session on the primary database
#   ./dev test         Run the backend test suite
#   ./dev typecheck    Type-check the frontend
#   ./dev migrate      Run pending migrations
#   ./dev prepare      Idempotent database preparation (create + migrate + queue schema)
#   ./dev seed         Load development seed data (idempotent)
#   ./dev restart      Restart application services
#   ./dev ps           Show service status
#   ./dev run ...      Run an arbitrary command in the backend image
#   ./dev npm ...      Run an arbitrary npm command in the frontend image
#
# Topology (one container per concern, each built from its own directory):
#
#   postgres   database/    PostgreSQL 18
#   backend    backend/     Rails: HTML shell, Inertia props, GraphQL
#   worker     backend/     Solid Queue
#   frontend   frontend/    Vite dev server with HMR
#
# Design notes:
#   * Compose is the single source of truth for the topology; this script only sequences
#     it and fails loudly with actionable messages.
#   * Nothing destructive ever runs automatically. No db:reset, no db:drop.
#   * `./dev` returns once the stack is up. The stack keeps running in the background and
#     is stopped only by `./dev down`, so closing a log window never takes the app down.
#   * Starting the stack clears logs/*.log and stops any leftover followers, so each log
#     window shows the current boot rather than an accumulation of previous ones.
#   * Per-query SQL logging is off by default because it drowns the worker. `LOG_SQL=true`
#     turns it back on.
#   * Hot reload is off in both processes: Rails loads code once at boot and Vite serves
#     without HMR or a file watcher. Source is still bind-mounted, so `./dev restart`
#     applies an edit without a rebuild.
#   * Written for the bash 3.2 that ships with macOS: no associative arrays, no `mapfile`,
#     and no expansion of a possibly-empty array under `set -u`.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")"

readonly PROJECT_ROOT="$PWD"
readonly COMPOSE_PROJECT="sourcebox"
readonly APP_SERVICES=(backend worker frontend)

# Every service that gets its own log window, in the order the windows open.
readonly LOG_SERVICES=(postgres backend worker frontend)
readonly LOG_DIR="logs"
readonly LOG_TAIL=100

# Each service's build context is its own directory, so a proxy CA has to be staged into
# each one. This is the cost of keeping the contexts separable, and it is worth paying:
# neither Dockerfile can reach outside its own directory.
readonly CERT_DIRS=(backend/docker/certs frontend/docker/certs)

# --- Output helpers -----------------------------------------------------
if [ -t 1 ]; then
  readonly C_RESET=$'\033[0m' C_BOLD=$'\033[1m' C_DIM=$'\033[2m'
  readonly C_RED=$'\033[31m' C_GREEN=$'\033[32m' C_YELLOW=$'\033[33m' C_BLUE=$'\033[34m'
else
  readonly C_RESET='' C_BOLD='' C_DIM='' C_RED='' C_GREEN='' C_YELLOW='' C_BLUE=''
fi

step() { printf '%s==>%s %s%s%s\n' "$C_BLUE" "$C_RESET" "$C_BOLD" "$1" "$C_RESET"; }
info() { printf '    %s%s%s\n' "$C_DIM" "$1" "$C_RESET"; }
ok()   { printf '    %s✓%s %s\n' "$C_GREEN" "$C_RESET" "$1"; }
warn() { printf '%s warn %s %s\n' "$C_YELLOW" "$C_RESET" "$1" >&2; }

die() {
  printf '\n%s error %s %s\n' "$C_RED" "$C_RESET" "$1" >&2
  shift
  for line in "$@"; do printf '        %s\n' "$line" >&2; done
  printf '\n'
  exit 1
}

# --- Quoting helpers ----------------------------------------------------
#
# Two separate escaping layers are needed to open a log window, and conflating them is how
# a project path containing a space or an apostrophe breaks the script:
#
#   shell_quote      makes a value safe inside the command string the new shell will run
#   applescript_quote makes that whole command safe inside an AppleScript string literal

shell_quote() {
  # Wrap in single quotes and escape any embedded single quote as '\''.
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

applescript_quote() {
  # Backslashes first, then double quotes, or the escapes would be double-escaped.
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

# --- Preflight ----------------------------------------------------------

require_docker() {
  command -v docker >/dev/null 2>&1 || die \
    "Docker is not installed." \
    "Install Docker Desktop: https://docs.docker.com/desktop/"

  docker compose version >/dev/null 2>&1 || die \
    "The Docker Compose v2 plugin is unavailable." \
    "Update Docker Desktop, or install the compose plugin."

  if ! docker info >/dev/null 2>&1; then
    local hint="Start it and re-run ./dev"
    case "$(uname -s)" in
      Darwin) hint="Start Docker Desktop:  open -a Docker" ;;
      Linux)  hint="Start the daemon:      sudo systemctl start docker" ;;
    esac
    die "Docker is installed but the daemon is not running." "$hint"
  fi
}

require_env_file() {
  [ -f .env ] && return 0

  die "No .env file found." \
    "Create one from the template, then fill in the blanks:" \
    "" \
    "    cp .env.example .env" \
    "" \
    "At minimum set SECRET_KEY_BASE. Generate one with:" \
    "" \
    "    ./dev run bin/rails secret" \
    "" \
    "Google login additionally needs GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET."
}

# Warn about placeholders rather than letting the app fail later with a confusing stack
# trace.
check_env_values() {
  local missing=() secret google_id
  secret=$(grep -E '^SECRET_KEY_BASE=' .env | cut -d= -f2- || true)
  google_id=$(grep -E '^GOOGLE_CLIENT_ID=' .env | cut -d= -f2- || true)

  [ -z "$secret" ] && missing+=("SECRET_KEY_BASE is empty (run: ./dev run bin/rails secret)")
  [ -z "$google_id" ] && missing+=("GOOGLE_CLIENT_ID is empty — Google login will not work")

  if [ ${#missing[@]} -gt 0 ]; then
    for m in "${missing[@]}"; do warn "$m"; done
  fi
}

# Networks that intercept TLS (Zscaler, Netskope, corporate MITM proxies) break
# `bundle install` and `npm ci` inside containers, because the container trusts neither the
# proxy's root CA nor — in Node's case — the system trust store at all.
#
# The host already trusts it, so detect the CA the host was configured with and stage it
# where each Dockerfile picks it up. Turns an opaque mid-build TLS failure into a no-op.
stage_proxy_ca() {
  local dir
  for dir in "${CERT_DIRS[@]}"; do mkdir -p "$dir"; done

  # Already staged by hand or by a previous run.
  if ls -A backend/docker/certs/*.crt >/dev/null 2>&1; then
    ok "corporate CA already staged"
    return 0
  fi

  local candidate="" var=""
  for var in NODE_EXTRA_CA_CERTS SSL_CERT_FILE CURL_CA_BUNDLE REQUESTS_CA_BUNDLE AWS_CA_BUNDLE; do
    local value="${!var:-}"
    if [ -n "$value" ] && [ -r "$value" ]; then candidate="$value"; break; fi
  done

  [ -z "$candidate" ] && return 0

  for dir in "${CERT_DIRS[@]}"; do cp "$candidate" "$dir/proxy-ca.crt"; done
  ok "staged TLS-inspection CA from \$${var}"
  info "detected a TLS-inspecting proxy; builds would otherwise fail on HTTPS"
}

compose() { docker compose -p "$COMPOSE_PROJECT" "$@"; }

# --- Orchestration steps ------------------------------------------------

build_images() {
  step "Building images"
  info "backend (Ruby) · frontend (Node) — built in parallel, backend shared with worker"
  # "$@" rather than a local array: macOS ships bash 3.2, where expanding an empty array
  # as "${arr[@]}" trips `set -u`. "$@" is special-cased and safe when empty.
  # backend and worker resolve to the same image, so Compose builds it once.
  compose build "$@"
  ok "images ready"
}

start_database() {
  step "Starting PostgreSQL 18"
  compose up -d postgres

  info "waiting for the health check to pass"
  local attempts=60 i=1 status
  while [ "$i" -le "$attempts" ]; do
    status=$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' \
      "$(compose ps -q postgres)" 2>/dev/null || echo "starting")

    case "$status" in
      healthy) ok "PostgreSQL is accepting connections"; return 0 ;;
      unhealthy) die "PostgreSQL reported unhealthy." "Inspect it with:  ./dev logs postgres" ;;
    esac

    sleep 2
    i=$((i + 1))
  done

  die "PostgreSQL did not become healthy in time." "Inspect it with:  ./dev logs postgres"
}

# Idempotent. db:prepare creates the databases if absent, runs pending migrations, and
# loads db/queue_schema.rb into the queue database. On an existing database it does nothing
# beyond applying new migrations. It never drops anything.
prepare_database() {
  step "Preparing databases"
  info "db:prepare — creates if missing, migrates if pending, never destructive"
  compose run --rm --no-deps backend bin/rails db:prepare
  ok "schema up to date"
}

start_services() {
  step "Starting application services"
  info "backend (Rails) · worker (Solid Queue) · frontend (Vite HMR)"
  compose up -d "${APP_SERVICES[@]}"
  ok "all services started"
}

# --- Per-service log windows -------------------------------------------
#
# One iTerm2 window per service instead of a single interleaved stream. Four services
# producing structured JSON into one terminal is unreadable in practice: a Rails backtrace
# and Vite's HMR chatter end up shredded together. Separate windows also mean a noisy
# service can be scrolled or searched without disturbing the others.
#
# Each window tees to logs/<service>.log so history survives closing the window, and so a
# failure can be grepped after the fact rather than scrolled back to.
#
# Critically, these windows are only viewers. They run `docker compose logs`, which
# attaches to an already-running stack, so closing a window — or all of them — leaves the
# containers alone. Only `./dev down` stops anything.

require_iterm() {
  if [ "$(uname -s)" != "Darwin" ]; then
    return 1
  fi

  command -v osascript >/dev/null 2>&1 || die \
    "osascript is unavailable, so iTerm2 windows cannot be opened." \
    "The stack is running. Follow logs inline with:  ./dev logs"

  # Resolving the bundle id is the cheapest reliable installation check; it does not
  # launch the app.
  if ! osascript -e 'id of application "iTerm"' >/dev/null 2>&1; then
    die "iTerm2 is not installed, so per-service log windows cannot be opened." \
      "Install it:" \
      "" \
      "    brew install --cask iterm2" \
      "" \
      "The stack is already running. In the meantime, follow logs inline with:" \
      "" \
      "    ./dev logs            (all services, interleaved)" \
      "    ./dev logs backend    (one service)"
  fi

  return 0
}

# Builds the shell command a log window runs.
#
# `2>&1` before the pipe so stderr is captured too — Rails writes plenty there, and losing
# it is exactly the case where you need the log. `tee` keeps the output live on screen
# while writing the file.
log_window_command() {
  local service="$1"
  printf 'cd %s && docker compose -p %s logs -f --tail=%s %s 2>&1 | tee %s' \
    "$(shell_quote "$PROJECT_ROOT")" \
    "$(shell_quote "$COMPOSE_PROJECT")" \
    "$(shell_quote "$LOG_TAIL")" \
    "$(shell_quote "$service")" \
    "$(shell_quote "$LOG_DIR/$service.log")"
}

open_log_window() {
  local service="$1"
  local command escaped_command escaped_title stderr status

  command="$(log_window_command "$service")"
  escaped_command="$(applescript_quote "$command")"
  escaped_title="$(applescript_quote "$COMPOSE_PROJECT · $service")"

  # `|| status=$?` rather than letting a non-zero exit kill the script: a permissions
  # failure needs to be explained, not just propagated.
  status=0
  stderr=$(osascript <<APPLESCRIPT 2>&1 >/dev/null
tell application "iTerm"
  activate
  set newWindow to (create window with default profile)
  tell current session of newWindow
    set name to "$escaped_title"
    write text "$escaped_command"
  end tell
end tell
APPLESCRIPT
  ) || status=$?

  if [ "$status" -ne 0 ]; then
    # -1743 is macOS refusing the Apple event because this terminal has not been granted
    # automation access. It is the single most common failure here, and the message
    # macOS produces on its own is not actionable.
    case "$stderr" in
      *-1743*|*"Not authorized"*|*"not allowed"*)
        die "macOS blocked this terminal from controlling iTerm2." \
          "Grant automation access, then re-run ./dev windows:" \
          "" \
          "    System Settings → Privacy & Security → Automation" \
          "    → enable iTerm for your terminal application" \
          "" \
          "The stack is already running; only the log windows failed to open."
        ;;
      *)
        die "Could not open an iTerm2 window for '$service'." \
          "osascript said:" \
          "" \
          "    $stderr" \
          "" \
          "The stack is already running. Follow logs inline with:  ./dev logs"
        ;;
    esac
  fi
}

# Each run starts from a clean slate: stale followers are stopped and the log files this
# script writes are removed. Without this, a second `./dev` leaves two `tee` processes
# appending to every file and twice as many windows on screen, and the files grow across
# boots until a search returns hits from a container that no longer exists.
reset_log_files() {
  mkdir -p "$LOG_DIR"

  local service
  for service in "${LOG_SERVICES[@]}"; do
    # These processes are viewers — `docker compose logs` only reads. Stopping one never
    # touches a container. `tee` exits on its own once its stdin closes.
    pkill -f "compose -p $COMPOSE_PROJECT logs -f --tail=$LOG_TAIL $service" >/dev/null 2>&1 || true

    # Unlink rather than truncate: a follower that outlives the pkill keeps writing to
    # the old inode instead of leaving a hole of NULs at the head of the new file.
    # Each file is named explicitly rather than `rm -rf logs/`, so anything else that
    # happens to live in this directory survives.
    rm -f "$LOG_DIR/$service.log"
  done
}

open_log_windows() {
  if ! require_iterm; then
    warn "per-service log windows are macOS/iTerm2 only; streaming inline instead"
    info "Ctrl+C detaches from the logs — the stack keeps running until ./dev down"
    compose logs -f --tail="$LOG_TAIL" || true
    return 0
  fi

  reset_log_files

  step "Opening a log window per service"
  local service
  for service in "${LOG_SERVICES[@]}"; do
    open_log_window "$service"
    info "$service → $LOG_DIR/$service.log"
  done
  ok "${#LOG_SERVICES[@]} windows open"
}

print_banner() {
  local backend_port="${BACKEND_PORT:-3000}"
  local frontend_port="${FRONTEND_PORT:-5173}"
  local pg_port="${POSTGRES_PORT:-5432}"

  cat <<BANNER

  ${C_BOLD}Sourcebox is running${C_RESET}

    App          ${C_BLUE}http://localhost:${backend_port}${C_RESET}
    Login        ${C_BLUE}http://localhost:${backend_port}/login${C_RESET}
    GraphQL      ${C_BLUE}http://localhost:${backend_port}/graphql${C_RESET}  (POST)
    Health       ${C_BLUE}http://localhost:${backend_port}/health${C_RESET} · ${C_BLUE}/ready${C_RESET}
    Vite (HMR)   ${C_BLUE}http://localhost:${frontend_port}${C_RESET}
    PostgreSQL   ${C_BLUE}postgres://localhost:${pg_port}${C_RESET}

  ${C_DIM}Open the app on the backend port — Rails renders the HTML and loads JS from Vite.${C_RESET}
  ${C_DIM}Hot reload is off. Apply a change with:  ./dev restart${C_RESET}

BANNER
}

print_detached_notice() {
  cat <<NOTICE
  ${C_DIM}The stack keeps running in the background. Closing a log window does not stop it.${C_RESET}

    Stop everything    ${C_BOLD}./dev down${C_RESET}
    Restart everything    ${C_BOLD}./dev restart${C_RESET}
    Re-open windows    ${C_BOLD}./dev windows${C_RESET}
    Service status     ${C_BOLD}./dev ps${C_RESET}

NOTICE
}

up() {
  require_docker
  require_env_file
  check_env_values
  stage_proxy_ca

  build_images "$@"
  start_database
  prepare_database
  start_services
  print_banner
  open_log_windows
  print_detached_notice
}

# --- Command dispatch ---------------------------------------------------

case "${1:-up}" in
  up|"")
    up
    ;;

  rebuild)
    require_docker
    require_env_file
    check_env_values
    stage_proxy_ca
    build_images --no-cache
    start_database
    prepare_database
    start_services
    print_banner
    open_log_windows
    print_detached_notice
    ;;

  windows)
    require_docker
    # Opening viewers for a stack that is not running would produce four windows that
    # immediately print nothing, which looks like a broken script rather than a stopped app.
    if [ -z "$(compose ps -q 2>/dev/null)" ]; then
      die "Nothing is running, so there are no logs to follow." "Start the stack with:  ./dev"
    fi
    open_log_windows
    print_detached_notice
    ;;

  down)
    require_docker
    step "Stopping the stack"
    compose down --remove-orphans
    ok "stopped"
    info "log windows will show 'no such service' or simply stop; closing them is safe"
    ;;

  logs)
    require_docker
    shift
    compose logs -f --tail=100 "$@"
    ;;

  ps|status)
    require_docker
    compose ps
    ;;

  restart)
    require_docker
    shift
    if [ $# -gt 0 ]; then
      compose restart "$@"
    else
      compose restart "${APP_SERVICES[@]}"
    fi
    ;;

  shell|sh|bash)
    require_docker
    service="${2:-backend}"
    # `frontend` is a slim Node image with no bash.
    shell_bin="/bin/bash"
    [ "$service" = "frontend" ] && shell_bin="/bin/sh"

    if [ -n "$(compose ps -q "$service" 2>/dev/null)" ]; then
      compose exec "$service" "$shell_bin"
    else
      compose run --rm "$service" "$shell_bin"
    fi
    ;;

  console|c)
    require_docker
    compose exec backend bin/rails console 2>/dev/null \
      || compose run --rm backend bin/rails console
    ;;

  dbconsole|psql)
    require_docker
    compose exec postgres psql \
      -U "$(grep -E '^POSTGRES_USER=' .env | cut -d= -f2-)" \
      -d "$(grep -E '^POSTGRES_DB=' .env | cut -d= -f2-)"
    ;;

  migrate)
    require_docker
    require_env_file
    start_database
    step "Running migrations"
    compose run --rm --no-deps backend bin/rails db:migrate
    ok "migrated"
    ;;

  prepare)
    require_docker
    require_env_file
    start_database
    prepare_database
    ;;

  seed)
    require_docker
    require_env_file
    start_database
    step "Seeding development data"
    info "idempotent — safe to re-run"
    compose run --rm --no-deps backend bin/rails db:seed
    ;;

  test)
    require_docker
    require_env_file
    start_database
    step "Running backend tests"
    compose run --rm -e RAILS_ENV=test backend bash -c 'bin/rails db:prepare && bin/rails test'
    ;;

  typecheck)
    require_docker
    step "Type-checking the frontend"
    compose run --rm --no-deps frontend npm run typecheck
    ;;

  run)
    require_docker
    shift
    [ $# -eq 0 ] && die "Nothing to run." "Usage:  ./dev run bin/rails routes"
    compose run --rm --no-deps backend "$@"
    ;;

  npm)
    require_docker
    shift
    [ $# -eq 0 ] && die "Nothing to run." "Usage:  ./dev npm run build"
    compose run --rm --no-deps frontend npm "$@"
    ;;

  help|-h|--help)
    # The header comment block is the help text. Stopping at the first non-comment line
    # rather than a hardcoded range means editing the header cannot desync the help output.
    awk 'NR >= 3 { if ($0 !~ /^#/) exit; sub(/^# ?/, ""); print }' "${BASH_SOURCE[0]}"
    ;;

  *)
    die "Unknown command: $1" "Run  ./dev help  for the available commands."
    ;;
esac
