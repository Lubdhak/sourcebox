# =========================
# Secrets — never commit
# =========================
.env
.env.*
!.env.example

backend/config/master.key
backend/config/credentials/*.key

*.pem
*.p12
*.pfx
*.key

# Corporate proxy CAs are machine- and network-specific. Each service's build context has
# its own certs directory (the Dockerfiles cannot reach outside their own directory), and
# the placeholder README in each is tracked so the directory exists on a fresh clone.
backend/docker/certs/*.crt
frontend/docker/certs/*.crt

# =========================
# Backend (Rails)
# =========================
backend/log/*
!backend/log/.keep
backend/tmp/*
!backend/tmp/.keep
backend/storage/*
!backend/storage/.keep

backend/.bundle/
backend/vendor/bundle/
backend/public/assets
backend/.byebug_history

# =========================
# Frontend (Vite)
# =========================
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.tsbuildinfo

.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# =========================
# Docker
# =========================
docker-compose.override.yml

# Per-service log files written by the `./dev` log windows (tee'd from docker compose logs).
/logs/

# =========================
# Test / coverage artifacts
# =========================
backend/coverage/
backend/tmp/screenshots/
backend/tmp/capybara/

# =========================
# Databases
# =========================
*.sqlite3
*.sqlite3-*

# =========================
# OS / editor
# =========================
.DS_Store
Thumbs.db
Desktop.ini
*~
*.swp
*.swo
*.tmp
*.temp
*.bak
*.orig

.idea/
*.iml
.vscode/*
!.vscode/settings.example.json
backend/tmp/*