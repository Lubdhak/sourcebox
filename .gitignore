/docs/.vitepress/dist/

# =========================
# Local Docker data
# =========================
docker-data/
postgres-data/

# =========================
# Local development scripts
# =========================
*.local.sh

# =========================
# Logs
# =========================
*.log

# =========================
# GraphQL generated files
# =========================
/app/graphql/generated/
/app/frontend/graphql/generated/

# =========================
# Generated build artifacts
# =========================
/build/
/dist/

# =========================
# Secrets / certificates
# =========================
*.pem
*.key
*.crt
*.p12
*.pfx

# Keep example certificates if needed
!*.example.pem
!*.example.key
# Ignore key files for decrypting credentials and more.
/config/*.key


# Corporate proxy CAs are machine-specific; never commit them.
/docker/certs/*.crt
!/docker/certs/.keep
