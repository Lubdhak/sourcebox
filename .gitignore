# =========================
# Rails
# =========================
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

/storage/*
!/storage/.keep

/public/assets
/public/packs
/public/vite
/public/vite-dev
/public/uploads

.byebug_history

# Rails credentials / secrets
/config/master.key
/config/credentials/*.key

# =========================
# Environment
# =========================
.env
.env.*
!.env.example
!.env.test.example
!.env.production.example

# =========================
# Ruby / Bundler
# =========================
.bundle/
/vendor/bundle/

# =========================
# Node / React / Vite
# =========================
node_modules/
/.npm
/.yarn
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Vite
dist/
.vite/

# =========================
# TypeScript
# =========================
*.tsbuildinfo

