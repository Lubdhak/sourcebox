# Copy to .env and fill in. `.env` is gitignored and must never be committed.
#
# In production do NOT use a .env file. Inject these as environment variables from your
# platform's secret store (ECS task secrets, Kubernetes Secret, Fly secrets, Cloud Run
# secret references) so they never land in an image layer or a git object.

# --- Rails ---------------------------------------------------------------
RAILS_ENV=development
RAILS_LOG_LEVEL=debug
RAILS_MAX_THREADS=5

# Log one structured event per SQL query. Off by default: it is the highest-volume event in
# the app, and in the worker it is the only one, because Solid Queue's pollers query for
# work every half second and would bury the job events worth reading. Turn it on while
# debugging a specific query, then turn it off.
# LOG_SQL=true

# Generate with: ./dev run bin/rails secret
# Must be STABLE across deploys: Devise 5 derives all token signing from it, so rotating it
# invalidates every outstanding password-reset and confirmation token.
SECRET_KEY_BASE=

# --- Ports (host side) ---------------------------------------------------
# Open the app on BACKEND_PORT. Rails renders the HTML and points the browser at Vite on
# FRONTEND_PORT for JavaScript.
BACKEND_PORT=3000
FRONTEND_PORT=5173

# --- PostgreSQL 18 ------------------------------------------------------
# `postgres` is the compose service name; docker-compose.yml overrides POSTGRES_HOST to it
# for the containers. The value here is what host-side tools (psql, a GUI client) should
# use.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=sourcebox
POSTGRES_USER=sourcebox_dev
POSTGRES_PASSWORD=sourcebox_dev

# The queue database is "${POSTGRES_DB}_queue", declared in backend/config/database.yml and
# created by database/init.sql on first initialisation.

# --- Google OAuth2 ------------------------------------------------------
# https://console.cloud.google.com/ -> APIs & Services -> Credentials
# Authorised redirect URI must be exactly:
#   http://localhost:3000/users/auth/google_oauth2/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Hot reload (development) -------------------------------------------
# Both default to false. Turning either on has a cost on Docker Desktop: the bind mount
# cannot use inotify, so the watcher polls.
#
# FRONTEND_HOT_RELOAD=true  Vite HMR. Also requires a backend restart so Rails injects
#                           the Vite client and React Refresh preamble.
# BACKEND_HOT_RELOAD=true   Rails reloads application code between requests. The worker
#                           never reloads — `./dev restart worker` for job changes.
FRONTEND_HOT_RELOAD=true
BACKEND_HOT_RELOAD=false

# --- Frontend ------------------------------------------------------------
# Development: docker-compose.yml sets VITE_DEV_SERVER_URL for the backend, which puts
# FrontendAssets::Manifest into dev-server mode. Nothing to set here.
#
# Production: set ASSET_HOST to wherever the frontend container or CDN is served from. The
# backend fetches ${ASSET_HOST}/manifest.json to resolve hashed filenames.
# ASSET_HOST=https://assets.example.com

# Enforce the Content Security Policy instead of only reporting violations. Leave unset
# until the violation reports are quiet.
# CSP_ENFORCE=1

# --- Solid Queue --------------------------------------------------------
JOB_CONCURRENCY=1
JOB_CONCURRENCY_CRITICAL=1
