# Keep the build context small and free of anything machine-specific.

# --- Secrets: never in an image layer -----------------------------------
.env
.env.*
!.env.example
config/master.key
config/credentials/*.key

*.pem
*.p12
*.pfx
# Exception: the opt-in corporate proxy CA the Dockerfile installs. A public certificate,
# not a secret.
!docker/certs/*.crt

# --- Version control ----------------------------------------------------
.git
.gitignore

# --- Generated / transient ---------------------------------------------
log/*
!log/.keep
tmp/*
!tmp/.keep
storage/*
!storage/.keep

vendor/bundle
.bundle

# --- Not needed at runtime ---------------------------------------------
test
spec
.rubocop.yml
README.md

.DS_Store
.idea
.vscode
