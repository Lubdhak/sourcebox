<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <title><%= content_for(:title) || "Sourcebox" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%# Required. Both the GraphQL client and the Google login form read this token. %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>
    <%= inertia_headers %>

    <%#
      Preconnect to the asset origin.

      In production the frontend is a separate container on a different origin, so the
      browser would otherwise pay DNS + TCP + TLS before it can even start downloading the
      JS. This overlaps that handshake with HTML parsing.
    %>
    <% if (asset_origin = FrontendAssets::Manifest.instance.asset_host).present? %>
      <link rel="preconnect" href="<%= asset_origin %>" crossorigin>
    <% end %>

    <%#
      All frontend tags come from the Vite manifest published by the frontend project.
      Rails never builds or bundles anything: see FrontendAssets::Manifest.
    %>
    <%= frontend_assets_tags %>
  </head>

  <body class="h-full bg-slate-50 text-slate-900 antialiased dark:bg-slate-950 dark:text-slate-100">
    <%= yield %>
  </body>
</html>
