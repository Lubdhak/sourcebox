# Copy to .env and fill in. `.env` is gitignored and must never be committed.
#
# In production do NOT use a .env file. Inject these as environment variables from
# your platform's secret store (ECS task secrets, Kubernetes Secret, Fly secrets,
# Cloud Run secret references) so they never land in an image layer or a git object.

# --- Rails ---------------------------------------------------------------
RAILS_ENV=development
RAILS_LOG_LEVEL=debug
RAILS_MAX_THREADS=5

# Log one structured event per SQL query. Off by default; it buries the worker log.
# LOG_SQL=true

# Generate with: bin/rails secret
# Must be STABLE across deploys: Devise 5 derives all token signing from it, so
# rotating it invalidates every outstanding password-reset and confirmation token.
SECRET_KEY_BASE=bda76d592faeabbea9532a24233e0f4762a67cddcbe4060a8b487ab6bf5fbecbcf3727aa58eda44ee0f92045eccf40453a409950425385b4d1c4a9c897cc07a3

# --- PostgreSQL 18 ------------------------------------------------------
# `postgres` is the compose service name. Use 127.0.0.1 from the host, or
# host.docker.internal from inside a container talking to a host-run server.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sourcebox
POSTGRES_USER=sourcebox_dev
POSTGRES_PASSWORD=sourcebox_dev

# The queue database is derived as "${POSTGRES_DB}_queue" by config/database.yml
# and created by docker/postgres/init.sql.

# --- Google OAuth2 ------------------------------------------------------
# https://console.cloud.google.com/ -> APIs & Services -> Credentials
# Authorised redirect URI must be exactly:
#   http://localhost:3000/users/auth/google_oauth2/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# --- Solid Queue --------------------------------------------------------
JOB_CONCURRENCY=1
JOB_CONCURRENCY_CRITICAL=1

# --- Ports (host side) ---------------------------------------------------
BACKEND_PORT=3000
FRONTEND_PORT=5173

# --- Hot reload (development) -------------------------------------------
# Both default to false. Turning either on has a cost on Docker Desktop: the bind
# mount cannot use inotify, so the watcher polls.
#
# FRONTEND_HOT_RELOAD=true  Vite HMR. Restart frontend and backend after changing this.
# BACKEND_HOT_RELOAD=true   Rails reloads application code between requests. The worker
#                           never reloads — `./dev restart worker` for job changes.
FRONTEND_HOT_RELOAD=true
BACKEND_HOT_RELOAD=false
